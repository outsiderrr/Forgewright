    "business_entry_b3": {
      "node_id": "business_entry_b3",
      "type": "dialogue",
      "narration": "维克用两指夹起银色书签，像称量一张薄纸的重量。钟摆又响了一下。他的笑意停在嘴角，没有再往上走，目光却落在你的手套和衣袖之间。\n\n“那批文书已经有人在竞价，数目到了几千美元，还在往上走。”\n\n“原件若能回到我手里，我仍愿意付这个价。出处、经过、谁碰过它，我都可以不问。”",
      "speaker_ref": "char_vick",
      "location_ref": "scene_vick_antique_shop",
      "on_enter_effects": [],
      "options": [
