    },
    "business_entry_b5": {
      "node_id": "business_entry_b5",
      "type": "dialogue",
      "narration": "柜台后的帘子微微晃了一下，后屋的动静随即停住。维克伸手扶正袖扣，指节在铜扣上慢慢转了半圈。\n\n「他的遗体现在在哪里？家里、学院，还是已经落到警察手里？」\n\n「这种问题会影响一批文书的价钱，也会影响谁还敢伸手。」",
      "speaker_ref": "char_vick",
      "location_ref": "scene_vick_antique_shop",
      "on_enter_effects": [],
      "options": [
        {
          "option_id": "opt_business_entry_b5_continue",
          "text": "还有谁会伸手？",
          "target_node_id": "business_entry_b6",
