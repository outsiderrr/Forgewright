    "soft_uncanny_detail_b5": {
      "node_id": "soft_uncanny_detail_b5",
      "type": "dialogue",
      "narration": "维克没有立刻回答。他用指节轻敲账册边缘，视线停在桌上那张空白收据上，又慢慢抬起，看向玩家的手。\n\n「那批文书不只是价格被抬高了。」\n\n「我担心有别的力量正往它们周围聚，像人听见钱币声会靠近一样。」",
      "speaker_ref": "char_vick",
      "location_ref": "scene_vick_antique_shop",
      "on_enter_effects": [],
      "options": [
        {
          "option_id": "opt_soft_uncanny_detail_b5_continue",
