    "business_offer_line_b3": {
      "node_id": "business_offer_line_b3",
      "type": "dialogue",
      "narration": "维克把软布一角折回去，动作不急。柜台玻璃映着他的袖扣，也映着你靠近柜台的影子；店里仍没有其他脚步声。\n\n「莱特？他从前递过不止一次书货和手稿，够让人记住他的眼力。」\n\n「近来这批文书已被喊到数千美元，仍有人往上加；若原件在你能碰到的地方，别让它多换几只手。」",
      "speaker_ref": "char_vick",
      "location_ref": "scene_vick_antique_shop",
      "on_enter_effects": [],
      "options": [
        {
          "option_id": "opt_business_offer_line_b3_continue",
