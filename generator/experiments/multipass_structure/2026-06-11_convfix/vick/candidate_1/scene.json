    "business_offer_end": {
      "node_id": "business_offer_end",
      "type": "end",
      "narration": "维克听完“我知道了”，把银笔帽扣回去，便笺上留下报价、代理字样和一个可回访的店址。他没有把纸递得太近，只让你看清数字，随后又在页角写下你提到货源时用过的称呼。后屋的木地板响了一声，仍没人出来。你离开柜台时，玻璃门上的铃声很轻，店里古龙水的气味贴着门缝停了一会儿。\n\n「知道就好。」维克说，「生意最怕把能用的路说死。」",
      "speaker_ref": "char_vick",
      "location_ref": "scene_vick_antique_shop",
      "on_enter_effects": [],
      "options": []
    },
    "wright_name_line_b1": {
      "node_id": "wright_name_line_b1",
      "type": "dialogue",
      "narration": "维克把柜台上的放大镜合上，镜片扣住一小片黄铜标牌。后屋那点细响停了一瞬，又轻轻续上。店里没有别的脚步声。\n\n「莱特教授？当然，我认识他。」\n\n「他偶尔替我找些稀有书和手稿，账目清楚，来往也算体面。你问他，是以什么身份问？」",
      "speaker_ref": "char_vick",
      "location_ref": "scene_vick_antique_shop",
      "on_enter_effects": [],
      "options": [
        {
          "option_id": "opt_wright_name_line_b1_continue",
