GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# R2.7 — third-party OpenAI-compatible relay (poloai.top → Gemini 3.1 Pro
# backend). Selected when LLM_PROVIDER=poloai.
LLM_PROVIDER=gemini  # gemini | poloai
POLOAI_API_KEY=
POLOAI_BASE_URL=https://poloai.top/v1
POLOAI_MODEL_ID=gemini-3.1-pro-preview
# JSON-output strategy. Default json_schema (strict=false) per OpenAI
# standard; flip to json_object or prompt_only if the relay rejects
# response_format.json_schema. Schema is also embedded in system_prompt
# for the latter two modes as defense-in-depth.
POLOAI_JSON_MODE=json_schema  # json_schema | json_object | prompt_only
POLOAI_STRICT_SCHEMA=false    # only consulted in json_schema mode
