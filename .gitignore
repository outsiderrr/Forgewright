# Forgewright runtime artifacts (dev-only, never committed)
.env*
!.env.example
/generator/cost_log.jsonl
/generator/playtest_cost_log.jsonl
*.jsonl.lock
# experiments 整体 ignore，但 T-3P 共用 fixture 目录整目录放行（golden 测试引用，
# 未来新增 golden 不许静默漏 commit）。git 不能在被 ignore 的父目录下重新 include，
# 所以必须 `目录/*` + `!子目录/` 逐级放行，不能只加一条 `!` 负规则。
/generator/experiments/*
!/generator/experiments/multipass_structure/
/generator/experiments/multipass_structure/*
!/generator/experiments/multipass_structure/2026-06-29_t3p_fixture/
!/generator/experiments/multipass_structure/2026-07-08_t3p1_pack/
!/generator/experiments/multipass_structure/2026-07-08_t3p2_ingest_demo/
!/generator/experiments/multipass_structure/2026-07-09_t3p3_e2e/

# T-3P-3 版本 sidecar 的 fcntl 哨兵锁文件（transient；version_recorder 落地时生成，非内容）
*.version.json.lock

# Stage 1.5 visual assets — directories tracked, contents not (copyright + temp artifacts)
/content/visuals/_reference/*
!/content/visuals/_reference/.gitkeep
/content/visuals/_pending/
/generator/image_cost_log.jsonl
/generator/import_log.jsonl

# T-3.6a review UI — generated smoke-test screenshots (PR description carries copies)
/tools/review_ui/tests/_screenshots/
/tools/review_ui/tests/_screenshots_pr/

# Local secrets (T-3Y-1 + future LLM keys)
.env
.env.*
!.env.example
